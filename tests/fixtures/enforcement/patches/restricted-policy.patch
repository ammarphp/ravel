+def _controller_source_policy():
+    """The sole protected restricted-source policy of the controller-owned cwd.
+
+    Ownership and store failures propagate. Only an absent controller package or
+    an unowned working directory retains the legacy environment-list interface.
+    """
+    try:
+        from ravel.controller.store import RunStore, controller_owned
+    except ImportError as exc:
+        if isinstance(exc, ModuleNotFoundError) and exc.name in {'ravel', 'ravel.controller'}:
+            return None
+        raise
+    run_id = controller_owned(Path.cwd())
+    if run_id is None:
+        return None
+    rows = RunStore(run_id).scan('restricted-source-policy')
+    if type(rows) is not list or len(rows) != 1:
+        raise ValueError('controller run requires exactly one immutable restricted-source policy')
+    row = rows[0]
+    policy = row.get('record', row) if type(row) is dict else None
+    if (type(policy) is not dict or policy.get('kind') != 'restricted-sources'
+            or type(policy.get('fingerprints')) is not list or type(policy.get('documents')) is not list
+            or any(type(term) is not str or not term.strip() for term in policy['fingerprints'])
+            or any(type(document) is not dict or type(document.get('sha256')) is not str
+                   or not SHA.fullmatch(document['sha256'].lower()) for document in policy['documents'])):
+        raise ValueError('controller restricted-source policy is malformed')
+    return policy
+

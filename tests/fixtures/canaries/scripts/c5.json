{
 "schema_version": 1,
 "kind": "canary-worker-script",
 "rules": [
  {"name": "bounded-progress", "when": {"step": "research-[0-9a-f]{40}"},
   "outputs": {"outputs/public-record.json": {"kind": "research-action", "action": "progress",
    "reason": "Retain bounded progress and every unfinished scientific obligation.",
    "arguments_json": "{\"reason\":\"The single bounded decision is complete.\"}",
    "information_gain": {"decision": "stop",
     "expected_gain": "The one bounded decision is made; a further cycle would add no information this step's question admits.",
     "cost_justification": "The bounded form admits one cycle and no children; stopping spends nothing beyond it.",
     "evidence_input_ids": ["scientific-core"]}}}},
  {"name": "plan", "when": {"step": "judgment-decompose-.*"},
   "outputs": {"outputs/judgment-plan.json": {"$gen": "judgment_plan"}},
   "plan": {
    "rationale": "P2 decomposition: pin the table, derive both expectations, settle the method question, compare, ask the tolerance, decide and synthesize.",
    "deliverable_step": "synthesize",
    "steps": [
     {"id": "acquire-table", "kind": "acquire", "purpose": "Pin the supplied fictional measurement table as an accepted artifact.",
      "inputs": [{"artifact": "inputs/toy_measurements.csv"}],
      "outputs": [{"path": "outputs/measurements.json", "kind": "table", "required": true},
                  {"path": "outputs/normalization-ledger.json", "kind": "normalization-ledger", "required": true},
                  {"path": "outputs/yields.json", "kind": "binned-values", "required": true},
                  {"path": "outputs/trap-sweep.json", "kind": "trap-sweep", "required": true}],
      "check_inputs": {
       "check:physics.normalization_ledger.check": {"ledger": {"output": "outputs/normalization-ledger.json"},
                                                    "delivered": {"output": "outputs/yields.json"}},
       "check:validation.input_closure.check": {"fit": {"output": "outputs/measurements.json"},
                                                "reference": {"$input": "/contract-"}},
       "check:validation.validate_run_state.check_trap_sweep": {"sweep": {"source": "output", "step": "acquire-table",
                                                                          "path": "outputs/trap-sweep.json", "type": "path"}}},
      "depends_on": [], "budget_share": {"fraction": 0.1}, "protocols": ["P6"], "review": [], "obligations": []},
     {"id": "derive-hypotheses", "kind": "derive", "purpose": "Derive the toy observable under the quadratic and the quartic hypothesis.",
      "inputs": [{"artifact": "request"}], "outputs": [{"path": "outputs/expectations.json", "kind": "table", "required": true}],
      "check_inputs": {
       "check:validation.input_closure.check": {"fit": {"output": "outputs/expectations.json"},
                                                "reference": {"$input": "/contract-"}}},
      "depends_on": [], "budget_share": {"fraction": 0.15}, "protocols": ["P2"], "review": [], "obligations": []},
     {"id": "method-question", "kind": "subgraph", "graph": "research.loop", "purpose": "Settle whether a log-log slope or a ratio test separates the two powers better on four points.",
      "inputs": [{"artifact": "request"}], "outputs": [{"path": "outputs/method.json", "kind": "research-result", "required": true}],
      "depends_on": [], "budget_share": {"fraction": 0.25}, "protocols": ["P2"], "review": [], "obligations": []},
     {"id": "compare", "kind": "compare", "purpose": "Compare both expectations with the table using the settled method.",
      "inputs": [{"artifact": "acquire-table:outputs/measurements.json"}, {"artifact": "derive-hypotheses:outputs/expectations.json"}],
      "outputs": [{"path": "outputs/comparison.json", "kind": "comparison", "required": true}],
      "depends_on": ["acquire-table", "derive-hypotheses", "method-question"], "budget_share": {"fraction": 0.15},
      "protocols": ["P2", "P5"], "review": ["physics-critic"], "obligations": []},
     {"id": "ask-tolerance", "kind": "ask", "purpose": "Ask the operator for the tolerance that separates the two hypotheses.",
      "question": "Is a 5 percent tolerance acceptable for calling the dependence quadratic?",
      "options": [{"id": "accept", "description": "use 5 percent"}, {"id": "tighter", "description": "use 2 percent"}],
      "default_option": "accept",
      "default": {"assumption": "The synthetic comparison uses a five percent tolerance.",
       "default": "accept", "alternatives": ["tighter"], "claim_type": "comparison",
       "direction_established": false, "expected_sign": "unknown", "expected_size": "five percent",
       "reversible_knob": "tolerance_percent", "flag": {"checkin_flag": 3, "deviation": "synthetic tolerance default"},
       "physics_critical": false, "justification": null}, "inputs": [{"artifact": "request"}],
      "outputs": [{"path": "outputs/answer.json", "kind": "answer", "required": true}],
      "depends_on": [], "budget_share": {"fraction": 0.05}, "protocols": ["P7"], "review": [], "obligations": []},
     {"id": "decide-hypothesis", "kind": "decide", "purpose": "Decide which power the comparison supports.",
      "question": "Which power does the synthetic comparison support?",
      "inputs": [{"artifact": "compare:outputs/comparison.json"}, {"artifact": "ask-tolerance:outputs/answer.json"}],
      "outputs": [{"path": "outputs/decision.json", "kind": "judgment-record", "required": true}],
      "depends_on": ["compare", "ask-tolerance"], "budget_share": {"fraction": 0.1}, "protocols": ["P5"], "review": [],
      "obligations": [], "declared_class": "R2", "action": {"summary": "adopt the supported power as the reported answer", "kind": "method_choice"}},
     {"id": "synthesize", "kind": "synthesize", "purpose": "Write the answer with its uncertainty and assumptions.",
      "inputs": [{"artifact": "decide-hypothesis:outputs/decision.json"}],
      "outputs": [{"path": "outputs/answer-table.json", "kind": "table", "required": true}],
      "depends_on": ["decide-hypothesis"], "budget_share": {"fraction": 0.2}, "protocols": ["P1"], "review": [], "obligations": []}
    ]}},
  {"name": "replan", "when": {"step": "judgment-replan-.*"}, "outputs": {"outputs/judgment-plan.json": {"$gen": "judgment_plan"}}, "plan": {"rationale": "Replan for the comparison's request: keep the closed steps, derive the one further expectation point it asked for, and replace the comparison with one that includes it.", "deliverable_step": "synthesize", "steps": [{"id": "acquire-table", "kind": "acquire", "purpose": "Pin the supplied fictional measurement table as an accepted artifact.", "inputs": [{"artifact": "inputs/toy_measurements.csv"}], "outputs": [{"path": "outputs/measurements.json", "kind": "table", "required": true}, {"path": "outputs/normalization-ledger.json", "kind": "normalization-ledger", "required": true}, {"path": "outputs/yields.json", "kind": "binned-values", "required": true}, {"path": "outputs/trap-sweep.json", "kind": "trap-sweep", "required": true}], "check_inputs": {"check:physics.normalization_ledger.check": {"ledger": {"output": "outputs/normalization-ledger.json"}, "delivered": {"output": "outputs/yields.json"}}, "check:validation.input_closure.check": {"fit": {"output": "outputs/measurements.json"}, "reference": {"$input": "/contract-"}}, "check:validation.validate_run_state.check_trap_sweep": {"sweep": {"source": "output", "step": "acquire-table", "path": "outputs/trap-sweep.json", "type": "path"}}}, "depends_on": [], "budget_share": {"fraction": 0.1}, "protocols": ["P6"], "review": [], "obligations": []},
    {"id": "derive-hypotheses", "kind": "derive", "purpose": "Derive the toy observable under the quadratic and the quartic hypothesis.", "inputs": [{"artifact": "request"}], "outputs": [{"path": "outputs/expectations.json", "kind": "table", "required": true}], "check_inputs": {"check:validation.input_closure.check": {"fit": {"output": "outputs/expectations.json"}, "reference": {"$input": "/contract-"}}}, "depends_on": [], "budget_share": {"fraction": 0.15}, "protocols": ["P2"], "review": [], "obligations": []},
    {"id": "method-question", "kind": "subgraph", "graph": "research.loop", "purpose": "Settle whether a log-log slope or a ratio test separates the two powers better on four points.", "inputs": [{"artifact": "request"}], "outputs": [{"path": "outputs/method.json", "kind": "research-result", "required": true}], "depends_on": [], "budget_share": {"fraction": 0.25}, "protocols": ["P2"], "review": [], "obligations": []},
    {"id": "derive-point", "kind": "derive", "purpose": "Derive the one further expectation point the comparison asked for, from the same toy model.", "inputs": [{"artifact": "request"}], "outputs": [{"path": "outputs/expectation-point.json", "kind": "table", "required": true}], "check_inputs": {"check:validation.input_closure.check": {"fit": {"output": "outputs/expectation-point.json"}, "reference": {"$input": "/contract-"}}}, "depends_on": [], "budget_share": {"fraction": 0.05}, "protocols": ["P2"], "review": [], "obligations": []},
    {"id": "compare-extended", "kind": "compare", "purpose": "Compare both expectations with the table using the settled method.", "inputs": [{"artifact": "acquire-table:outputs/measurements.json"}, {"artifact": "derive-hypotheses:outputs/expectations.json"}, {"artifact": "derive-point:outputs/expectation-point.json"}], "outputs": [{"path": "outputs/comparison.json", "kind": "comparison", "required": true}], "depends_on": ["acquire-table", "derive-hypotheses", "method-question", "derive-point"], "budget_share": {"fraction": 0.15}, "protocols": ["P2", "P5"], "review": ["physics-critic"], "obligations": []},
    {"id": "ask-tolerance", "kind": "ask", "purpose": "Ask the operator for the tolerance that separates the two hypotheses.", "question": "Is a 5 percent tolerance acceptable for calling the dependence quadratic?", "options": [{"id": "accept", "description": "use 5 percent"},
    {"id": "tighter", "description": "use 2 percent"}], "default_option": "accept", "default": {"assumption": "The synthetic comparison uses a five percent tolerance.", "default": "accept", "alternatives": ["tighter"], "claim_type": "comparison", "direction_established": false, "expected_sign": "unknown", "expected_size": "five percent", "reversible_knob": "tolerance_percent", "flag": {"checkin_flag": 3, "deviation": "synthetic tolerance default"}, "physics_critical": false, "justification": null}, "inputs": [{"artifact": "request"}], "outputs": [{"path": "outputs/answer.json", "kind": "answer", "required": true}], "depends_on": [], "budget_share": {"fraction": 0.05}, "protocols": ["P7"], "review": [], "obligations": []},
    {"id": "decide-hypothesis", "kind": "decide", "purpose": "Decide which power the comparison supports.", "question": "Which power does the synthetic comparison support?", "inputs": [{"artifact": "compare-extended:outputs/comparison.json"}, {"artifact": "ask-tolerance:outputs/answer.json"}], "outputs": [{"path": "outputs/decision.json", "kind": "judgment-record", "required": true}], "depends_on": ["compare-extended", "ask-tolerance"], "budget_share": {"fraction": 0.1}, "protocols": ["P5"], "review": [], "obligations": [], "declared_class": "R2", "action": {"summary": "adopt the supported power as the reported answer", "kind": "method_choice"}},
    {"id": "synthesize", "kind": "synthesize", "purpose": "Write the answer with its uncertainty and assumptions.", "inputs": [{"artifact": "decide-hypothesis:outputs/decision.json"}], "outputs": [{"path": "outputs/answer-table.json", "kind": "table", "required": true}], "depends_on": ["decide-hypothesis"], "budget_share": {"fraction": 0.15}, "protocols": ["P1"], "review": [], "obligations": []}]}},
  {"name": "acquire", "when": {"step": "acquire-table"}, "provenance": true,
   "outputs": {"outputs/measurements.json": {"$gen": "toy_table"},
               "outputs/normalization-ledger.json": {"$gen": "normalization_ledger"},
               "outputs/yields.json": {"$gen": "delivered_yields"},
               "outputs/trap-sweep.json": {"$gen": "trap_sweep"}},
   "final": {"decisions": [{"statement": "Pinned the supplied fictional table with its normalization and trap sweep.",
                            "cites": ["final_record#/instruction_ack/manifest_sha256"]}]}},
  {"name": "derive", "when": {"step": "derive-hypotheses"}, "provenance": true,
   "outputs": {"outputs/expectations.json": {"$gen": "toy_table"}},
   "final": {"decisions": [{"statement": "Computed the fictional toy observable from the supplied inputs.",
                            "cites": ["final_record#/instruction_ack/manifest_sha256"]}]}},
  {"name": "derive-point", "when": {"step": "derive-point"}, "provenance": true, "outputs": {"outputs/expectation-point.json": {"$gen": "toy_table"}}, "final": {"decisions": [{"statement": "Computed the fictional toy observable from the supplied inputs.", "cites": ["final_record#/instruction_ack/manifest_sha256"]}]}},
  {"name": "compare-asks-for-more", "when": {"step": "compare"},
   "escalation": [{"kind": "new_experiment_required", "statement": "The two powers need one more derived point to separate.", "evidence": ["final_record#/instruction_ack/manifest_sha256"]}],
   "output": {"$gen": "toy_table"}},
  {"name": "compare-extended", "when": {"step": "compare-extended"}, "output": {"$gen": "toy_table"}},
  {"name": "decision", "when": {"step": "decide-hypothesis"},
   "output": {"schema_version": 1, "kind": "canary-decision", "decision": "quadratic", "uncertainty": "the quartic hypothesis is disfavoured by more than three standard deviations at g = 1"}}
 ],
 "include": "common.json"
}

{"schema_version": 1, "kind": "canary-worker-script", "rules": [
  {"name": "specify", "when": {"step": "specify"},
   "compute": {"rung": "full", "reason": "Execute the complete declared workflow within its finite approved allocation."},
   "workflow": "inputs/toy_workflow.smk", "targets": ["all"], "site": {"scheduler": "htcondor", "jobs": 4},
   "outputs": {"outputs/specification.json": {"$gen": "workflow_specification"},
               "outputs/scope.json": {"$gen": "study_scope"},
               "outputs/trap_sweep.json": {"$gen": "trap_sweep"}},
   "final": {"decisions": [{"statement": "Specified the supplied workflow as the batch study to prepare, inspect and run.",
                            "cites": ["final_record#/instruction_ack/manifest_sha256"]}]}},
  {"name": "conformance", "when": {"step": ".*conformance.*"},
   "output": {"schema_version": 1, "kind": "toy-conformance-check", "rules": {"positive": "pass", "monotone": "pass", "complete": "pass"}}}
 ], "include": "common.json"}

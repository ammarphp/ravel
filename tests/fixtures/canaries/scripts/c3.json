{
 "schema_version": 1,
 "kind": "canary-worker-script",
 "rules": [
  {
   "name": "author",
   "when": {
    "step": "m01-author"
   },
   "title": "A fictional toy note",
   "claims": [
    [
     "obs-low",
     "/rows/0/observable",
     "the toy observable at the lower coupling is 25.0"
    ],
    [
     "unc-low",
     "/rows/0/uncertainty",
     "with an uncertainty of 1.5"
    ],
    [
     "obs-high",
     "/rows/1/observable",
     "the toy observable at the higher coupling is 100.0"
    ],
    [
     "unc-high",
     "/rows/1/uncertainty",
     "with an uncertainty of 2.0"
    ]
   ],
   "outputs": {
    "outputs/claim_map.json": {
     "$gen": "claim_map"
    },
    "outputs/note.md": "# A fictional toy note\n\n## Result\n\nFrom the supplied fictional result, [[claim:obs-low]], [[claim:unc-low]]; [[claim:obs-high]], [[claim:unc-high]].\n",
    "outputs/trap_sweep.json": {
     "$gen": "trap_sweep"
    }
   },
   "final": {
    "decisions": [
     {
      "statement": "Mapped every stated value of the note to the supplied result.",
      "cites": [
       "final_record#/instruction_ack/manifest_sha256"
      ]
     }
    ]
   }
  },
  {
   "name": "meta-review",
   "when": {
    "step": "m04-review"
   },
   "output": {
    "schema_version": 1,
    "kind": "canary-review",
    "verdict": "accept",
    "findings": []
   }
  },
  {
   "name": "plan",
   "when": {
    "step": "judgment-decompose-.*"
   },
   "outputs": {
    "outputs/judgment-plan.json": {
     "$gen": "judgment_plan"
    }
   },
   "plan": {
    "rationale": "P2 decomposition: write the report from the supplied table.",
    "deliverable_step": "synthesize",
    "steps": [
     {
      "id": "synthesize",
      "kind": "synthesize",
      "purpose": "Write the short report from the pinned table.",
      "inputs": [
       {
        "artifact": "inputs/toy_measurements.csv"
       }
      ],
      "outputs": [
       {
        "path": "outputs/report.md",
        "kind": "document",
        "required": true
       }
      ],
      "depends_on": [],
      "budget_share": {
       "fraction": 0.3
      },
      "protocols": [
       "P1"
      ],
      "review": [],
      "obligations": []
     }
    ]
   }
  },
  {
   "name": "report",
   "when": {
    "step": "synthesize"
   },
   "outputs": {
    "outputs/report.md": "# A fictional report\n\nThe pinned fictional table is reported as supplied.\n"
   },
   "final": {
    "decisions": [
     {
      "statement": "Reported the pinned fictional table.",
      "cites": [
       "final_record#/instruction_ack/manifest_sha256"
      ]
     }
    ]
   }
  }
 ],
 "include": "common.json"
}

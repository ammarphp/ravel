\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ravel-figures}[2026/10/06 RAVEL documentation figures]
\RequirePackage{fontspec}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,fit,backgrounds,shapes.geometric,shapes.misc,shadows}
% A canvas layer under the background layer, so the page colour never covers group panels.
\pgfdeclarelayer{canvas}
\pgfsetlayers{canvas,background,main}
% Typeface: Inter (SIL Open Font License). Proportional figures: Inter's tabular feature also widens
% hyphens and commas, which spoils labels.
\setsansfont{Inter}[BoldFont={Inter SemiBold}, BoldItalicFont={Inter SemiBold Italic}]
\newfontfamily\ravelheavy{Inter}[UprightFont={Inter Bold}]
\renewcommand\familydefault{\sfdefault}
% Never hyphenate labels: names such as MadGraph5_aMC@NLO must stay whole.
\AtBeginDocument{\frenchspacing\hyphenpenalty=10000 \exhyphenpenalty=10000 \uchyph=0 \lefthyphenmin=62 \righthyphenmin=62}
% Type scale (points). Nothing below 9 pt: on the 170 mm canvas shown across GitHub's README column (about
% 830 px), 9 pt is about 15.5 px.
\newcommand\ravelTitleFont{\ravelheavy\fontsize{13}{15.5}\selectfont}
\newcommand\ravelNodeTitleFont{\bfseries\fontsize{11}{13.2}\selectfont}
\newcommand\ravelLabelFont{\fontsize{10}{12}\selectfont}
\newcommand\ravelSmallFont{\fontsize{9}{10.8}\selectfont}
% Colour mode: \def\ravelmode{dark} before loading selects the dark palette.
\providecommand\ravelmode{light}
\def\ravel@dark{dark}
\ifx\ravelmode\ravel@dark
%% palette:dark
\definecolor{rvbackground}{HTML}{0D1117}
\definecolor{rvtext}{HTML}{E6EDF3}
\definecolor{rvmuted}{HTML}{9198A1}
\definecolor{rvconnector}{HTML}{9198A1}
\definecolor{rvpeoplefill}{HTML}{3A2C1B}\definecolor{rvpeopleline}{HTML}{F8B452}
\definecolor{rvagentfill}{HTML}{3C2837}\definecolor{rvagentline}{HTML}{C775B3}
\definecolor{rvguardfill}{HTML}{412822}\definecolor{rvguardline}{HTML}{E76B4F}
\definecolor{rvravelfill}{HTML}{183142}\definecolor{rvravelline}{HTML}{80C8FD}
\definecolor{rvhepfill}{HTML}{1A3327}\definecolor{rvhepline}{HTML}{7CE6B3}
\definecolor{rvrecordsfill}{HTML}{292F33}\definecolor{rvrecordsline}{HTML}{C8D3DC}
%% end palette:dark
\else
%% palette:light
\definecolor{rvbackground}{HTML}{FFFFFF}
\definecolor{rvtext}{HTML}{1F2328}

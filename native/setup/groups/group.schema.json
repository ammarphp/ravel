{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Toolchain group fragment",
 "type": "object",
 "required": ["group"],
 "additionalProperties": false,
 "properties": {
  "group": {
   "type": "object",
   "required": ["id"],
   "additionalProperties": true,
   "description": "The inline group contract, validated by ravel.setup.manifest.validate. The components field and step cleanup fields pass through unchanged.",
   "properties": {
    "id": {"type": "string", "minLength": 1},
    "pin_file": {"type": "string", "pattern": "^native/setup/[^{}]+\\.json$", "description": "Verified local source ledger; unresolved pins hold acquisition."},
    "components": {},
    "steps": {"type": "array", "items": {"type": "object", "properties": {"cleanup": {}, "pin": {"type": "string", "minLength": 1}}, "additionalProperties": true}}
   }
  },
  "unreleased": {
   "type": "object",
   "required": ["groups", "operations"],
   "additionalProperties": false,
   "properties": {
    "groups": {
     "type": "array", "minItems": 1, "maxItems": 1,
     "items": {
      "type": "object", "required": ["id", "check", "reason"], "additionalProperties": false,
      "properties": {
       "id": {"type": "string", "minLength": 1},
       "check": {"type": "string", "minLength": 1},
       "reason": {"type": "string", "minLength": 1},
       "display_terms": {"type": "array", "items": {"type": "string"}}
      }
     }
    },
    "operations": {
     "type": "array",
     "items": {
      "type": "object", "required": ["mode", "groups"], "additionalProperties": false,
      "properties": {
       "mode": {"type": "string", "minLength": 1},
       "groups": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}}
      }
     }
    }
   }
  }
 }
}

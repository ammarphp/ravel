# MCFM build and run toolchain for arm64 Linux (GNU C, C++ and Fortran, CMake).
#
# The image holds compilers and the RAVEL build/check scripts only. MCFM source,
# the RAVEL overlay and the build directory stay on the host and are mounted at
# identical paths by the container launcher, so the build receipt and the binary's
# run path are the same inside and outside the container.
#
# The base must be pinned by digest. Record it once, after the owner approves the
# pull, with:
#   podman pull --platform linux/arm64 registry.fedoraproject.org/fedora:41
#   podman image inspect --format '{{.Digest}}' registry.fedoraproject.org/fedora:41
# then replace the placeholder below (and in base-image.json). `ravel backend
# image-build` refuses to build until the FROM line carries a real digest.
FROM registry.fedoraproject.org/fedora@sha256:fd6900fd292fc2e8eb2ce9c09d346f3f55333b5b283d64b88630cdf03845bc71

RUN dnf -y install gcc gcc-c++ gcc-gfortran cmake make git patch python3 file binutils \
    && dnf clean all \
    && mkdir -p /opt/ravel/bin

COPY build-mcfm.sh check-mcfm.sh write_mcfm_receipt.py /opt/ravel/bin/
RUN chmod 0755 /opt/ravel/bin/build-mcfm.sh /opt/ravel/bin/check-mcfm.sh \
    && { gcc --version | head -1; g++ --version | head -1; gfortran --version | head -1; cmake --version | head -1; } \
       > /opt/ravel/toolchain-versions.txt

LABEL org.ravel.recipe="mcfm-toolchain" org.opencontainers.image.description="GNU toolchain for the RAVEL MCFM build"

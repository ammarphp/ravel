# JHUGen/MELA build and run toolchain for x86-64 Linux (run under Rosetta on Apple silicon) (GNU C, C++ and Fortran, ROOT, Python).
#
# The image holds compilers, ROOT and the RAVEL build/check scripts only. The JHUGen and MELA sources
# and the build directory stay on the host and are mounted at identical paths by the container launcher,
# as for the MCFM recipe, so the build receipt and the run path agree inside and outside the container.
#
# This is the linux/amd64 variant of Containerfile: MCFM needs libquadmath, which Fedora aarch64 lacks, and MELA
# ships x86-64 libraries only. The base must be pinned by digest. Record it once, after the owner approves the pull, with:
#   podman pull --platform linux/amd64 registry.fedoraproject.org/fedora:41
#   podman image inspect --format '{{.Digest}}' registry.fedoraproject.org/fedora:41
# then replace the placeholder below (and in base-image.json). `ravel backend image-build` refuses to
# build until the FROM line carries a real digest.
FROM --platform=linux/amd64 registry.fedoraproject.org/fedora@sha256:3fb969dd07e631c17d12f5955bcb6db2078a6997eb68be76b6492e7bd6052e88

RUN dnf -y install gcc gcc-c++ gcc-gfortran make git patch python3 python3-numpy python3-devel python3-pybind11 root root-python3 tcsh file binutils \
    && dnf clean all \
    && mkdir -p /opt/ravel/bin

COPY build-jhugen-mela.sh check-jhugen-mela.sh wget-from-cache.sh /opt/ravel/bin/
RUN chmod 0755 /opt/ravel/bin/build-jhugen-mela.sh /opt/ravel/bin/check-jhugen-mela.sh /opt/ravel/bin/wget-from-cache.sh \
    && { gcc --version | head -1; gfortran --version | head -1; root-config --version; python3 --version; } \
       > /opt/ravel/toolchain-versions.txt

LABEL org.ravel.recipe="jhugen-mela-toolchain" org.opencontainers.image.description="GNU toolchain and ROOT for the RAVEL JHUGen/MELA build"

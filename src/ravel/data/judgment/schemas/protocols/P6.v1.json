{
  "title": "P6 source-ladder rows",
  "type": "object",
  "required": ["claim", "rungs"],
  "additionalProperties": false,
  "properties": {
    "claim": {"type": "string", "enum": ["found", "unavailable"]},
    "census": {
      "anyOf": [
        {"type": "object", "required": ["path", "sha256"], "additionalProperties": false,
         "properties": {"path": {"type": "string", "minLength": 1, "pattern": "\\S"},
                        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
        {"type": "null"}
      ]
    },
    "rungs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rung", "name", "status", "evidence", "reason"],
        "additionalProperties": false,
        "properties": {
          "rung": {"type": "integer", "minimum": 1, "maximum": 6},
          "name": {"type": "string", "enum": ["publication", "data_record", "public_code", "recast_database",
                                              "citing_work", "ask_physicist"]},
          "status": {"type": "string", "enum": ["OK", "ABSENT", "ERROR", "SKIPPED", "NOT_APPLICABLE"]},
          "evidence": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "reason": {"anyOf": [{"type": "string", "minLength": 1, "pattern": "\\S"}, {"type": "null"}]}
        }
      }
    }
  }
}

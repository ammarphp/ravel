{
  "title": "Stage recovery evidence: local diagnosis and external recipe search, co-primary",
  "type": "object",
  "required": ["failure", "local_diagnosis", "recipe_search", "diagnosis_class"],
  "additionalProperties": false,
  "properties": {
    "failure": {
      "type": "object",
      "required": ["step", "summary"],
      "additionalProperties": false,
      "properties": {
        "step": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,95}$"},
        "summary": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "local_diagnosis": {
      "type": "object",
      "required": ["summary", "evidence"],
      "additionalProperties": false,
      "properties": {
        "summary": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}
      }
    },
    "recipe_search": {
      "type": "object",
      "required": ["path", "sha256", "hits"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hits": {"type": "integer", "minimum": 0}
      }
    },
    "diagnosis_class": {"type": "string", "enum": ["generator_model", "infrastructure", "input", "statistics",
                                                   "implementation", "unknown"]}
  }
}

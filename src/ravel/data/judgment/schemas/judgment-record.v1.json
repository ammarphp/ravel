{
  "title": "judgment-record.v1",
  "description": "One judgment call: the question, at least two options (or the reason only one exists) with predicted consequences, the chosen option and its rationale, the protocol evidence its triggers require, reversibility and budget impact. The consequence class, its factors and the reviewer requirement are written by the controller, never taken from the worker.",
  "type": "object",
  "required": ["schema_version", "kind", "id", "step", "question", "options", "chosen", "rationale", "action",
               "triggers", "protocol_evidence", "reversibility", "budget_impact"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "judgment-record"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,95}$"},
    "step": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,95}$"},
    "question": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "predicted_consequences"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$"},
          "description": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "predicted_consequences": {"type": "string", "minLength": 1, "pattern": "\\S"}
        }
      }
    },
    "single_option_reason": {"anyOf": [{"type": "string", "minLength": 1, "pattern": "\\S"}, {"type": "null"}]},
    "chosen": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$"},
    "rationale": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "action": {"$ref": "action.v1.json"},
    "triggers": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_]*$"}},
    "protocol_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "P1": {"$ref": "protocols/P1.v1.json"},
        "P2": {"$ref": "protocols/P2.v1.json"},
        "P3": {"$ref": "protocols/P3.v1.json"},
        "P4": {"$ref": "protocols/P4.v1.json"},
        "P5": {"$ref": "protocols/P5.v1.json"},
        "P6": {"$ref": "protocols/P6.v1.json"},
        "P7": {"$ref": "protocols/P7.v1.json"},
        "P8": {"$ref": "protocols/P8.v1.json"},
        "method_ladder": {"type": "object"},
        "recovery": {"$ref": "protocols/recovery.v1.json"}
      }
    },
    "reversibility": {
      "type": "object",
      "required": ["kind", "note"],
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["reversible", "partially_reversible", "irreversible"]},
        "note": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "budget_impact": {
      "type": "object",
      "required": ["note"],
      "additionalProperties": false,
      "properties": {
        "note": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "wall_seconds": {"type": "number", "minimum": 0},
        "events": {"type": "integer", "minimum": 0},
        "broker_calls": {"type": "integer", "minimum": 0},
        "tokens": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "default": {"anyOf": [{"$ref": "protocols/P7.v1.json"}, {"type": "null"}]},
    "default_option": {"anyOf": [{"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$"}, {"type": "null"}]},
    "declared_class": {"anyOf": [{"type": "string", "enum": ["R0", "R1", "R2", "R3"]}, {"type": "null"}]},
    "class": {"type": "string", "enum": ["R0", "R1", "R2", "R3"]},
    "class_factors": {"type": "object"},
    "reviewer_requirement": {"type": "string", "enum": ["record", "report_at_next_checkin", "rdj_review", "authority"]},
    "authority_record": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "rdj_case": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "outcome": {"type": "string", "enum": ["pending", "confirmed", "overturned", "superseded"]}
  }
}

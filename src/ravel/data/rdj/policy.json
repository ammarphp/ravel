{
  "schema_version": 1,
  "kind": "rdj-policy",
  "classes": {
    "R0": {"min_depth": 1, "max_depth": 1, "roles": [], "revision_rounds": 0, "require_alternative": false,
           "require_tool_anchor": false, "independence": "none", "max_model_calls": 0},
    "R1": {"min_depth": 1, "max_depth": 2, "roles": ["edge_reviewer"], "revision_rounds": 1, "require_alternative": false,
           "require_tool_anchor": false, "independence": "self_attested_allowed", "max_model_calls": 6},
    "R2": {"min_depth": 2, "max_depth": 5, "roles": ["edge_reviewer", "critic", "verifier"], "revision_rounds": 2,
           "require_alternative": true, "require_tool_anchor": false, "independence": "transport_or_human", "max_model_calls": 24},
    "R3": {"min_depth": 3, "max_depth": 7, "roles": ["edge_reviewer", "critic", "verifier"], "revision_rounds": 3,
           "require_alternative": true, "require_tool_anchor": true, "independence": "transport_required", "max_model_calls": 40}
  },
  "gates": {
    "approve_plan": {"class": "R2", "irreversible": false},
    "launch": {"class": "R2", "irreversible": false, "consequence_facts": true,
               "lowerable_kinds": ["dry_run", "smoke_launch", "single_point_launch", "reuse_accepted_stage"],
               "lowerable_rungs": ["dry", "smoke"]},
    "failed_stage_feedback": {"class": "R1", "irreversible": false},
    "checkin2_accept": {"class": "R2", "irreversible": false},
    "correction": {"class": "R2", "irreversible": false},
    "deviation": {"class": "R2", "irreversible": false},
    "research_choice": {"class": "R1", "irreversible": false, "choice": true},
    "delivery": {"class": "R3", "irreversible": false},
    "final_task": {"class": "R3", "irreversible": false},
    "report_integrity": {"class": "R3", "irreversible": false},
    "export": {"class": "R3", "irreversible": true},
    "unblind": {"class": "R3", "irreversible": true},
    "spend_above_ceiling": {"class": "R3", "irreversible": true, "consequence_facts": true}
  },
  "gate_aliases": {
    "bulk": "launch", "scan": "launch", "smoke": "launch", "reuse": "launch",
    "checkin1": "approve_plan", "check-in-1": "approve_plan",
    "checkin2": "checkin2_accept", "check-in-2": "checkin2_accept",
    "checkin3": "delivery", "check-in-3": "delivery", "final": "final_task",
    "publish": "export"
  },
  "non_lowering_aliases": ["bulk", "scan"],
  "action_kinds": {
    "dry_run": "R0",
    "smoke_launch": "R0",
    "read_or_index": "R0",
    "replot_retained": "R0",
    "single_point_launch": "R1",
    "screening_choice": "R1",
    "reuse_accepted_stage": "R1",
    "bulk_launch": "R2",
    "scan_launch": "R2",
    "promotion": "R2",
    "tuning_change": "R2",
    "scope_change": "R3",
    "method_performance_claim": "R3",
    "replace_reviewed_outputs": "R3"
  },
  "irreversible_kinds": ["replace_reviewed_outputs"],
  "choice_kinds": ["screening_choice", "promotion", "tuning_change", "method_performance_claim"],
  "rungs": {"dry": "R0", "smoke": "R0"},
  "high_consequence": {"points_at_least": 50, "walltime_hours_at_least": 8},
  "cost_dimensions": {
    "absolute_cost": {"currency": "USD", "raise_above_usd": 0, "basis": "legacy_positive_spend_floor"},
    "authorized_budget_fraction": {"raise_above": null, "authority": "separate_verified_budget_required"},
    "irreversibility": {"minimum_class": "R3", "requires_human_approval": true},
    "scientific_consequence": {"when_declared": "raise_one_class"}
  },
  "conflict_default_relative_tolerance": 1e-9,
  "budgets": {"max_model_calls_per_run": 200, "max_model_calls_per_action": 80, "max_cases_per_action": 3,
              "max_reviews_per_edge": 10, "max_critic_broker_calls": 8, "max_critic_broker_calls_per_critique": 24},
  "input_snapshot_max_files": 65536,
  "common_mode": {"classes": ["R3"], "gates": ["delivery", "final_task"],
                  "anchor_kinds": ["tool_output", "measurement", "input_artifact", "retrieved_document", "external_fact"]},
  "verdict_records": {"kinds": ["research_meta_review", "protocol_meta_review_applied", "meta_review",
                                "manuscript_integrity_assessment", "manuscript_integrity_preparation", "integrity",
                                "integrity_verdict", "physics_review_verdict", "review_verdict", "rdj-receipt",
                                "agent_model_receipt"],
                      "path_patterns": ["*meta-review*", "*meta_review*", "*integrity-verdict*", "*integrity_verdict*"]},
  "r3_distinct_family": false,
  "tuning_classes": ["recipe_restoration", "implementation_correction", "calibration", "new_approximation"],
  "measurement_validators": {
    "certify_acceptance": "ravel.validation.certify_acceptance",
    "validate_cutflow": "ravel.validation.validate_cutflow",
    "numerical_witness": "ravel.validation.numerical_witness",
    "analysis_witness": "ravel.validation.analysis_witness",
    "statistical_model_witness": "ravel.validation.statistical_model_witness",
    "normalization_ledger": "ravel.physics.normalization_ledger"
  },
  "tool_producers": {
    "python_module_prefixes": ["ravel.physics.", "ravel.validation.", "ravel.plotting.", "ravel.toolkit.",
                               "ravel.limits", "ravel.workflow.cost_preflight", "ravel.workflow.pilot_cost"],
    "native_tools": ["mg5_aMC", "pythia_shower", "pythia_shower_merged", "DelphesHepMC2", "DelphesHepMC3",
                     "DelphesSTDHEP", "rivet", "rivet-mkanalysis", "root", "hadd"],
    "authored_script_prefixes": ["inputs/", "scripts/"]
  },
  "ravel_written_inputs": ["inputs/request.json", "inputs/task_contract.json", "inputs/cost_preflight.json",
                           "inputs/checkin1*", "inputs/resource_census.json", "inputs/route*.json",
                           "inputs/native_execution_plan.json", "inputs/user-steering/*"],
  "practice_anchor_kinds": ["retrieved_document", "external_fact", "user_requirement", "invariant"],
  "practice_source_classes": ["published_analysis", "experiment_recommendation", "standard_reference"],
  "independence_note": "Attestation shows which sessions were distinct. It does not show that the people or models behind them are independent in any deeper sense."
}

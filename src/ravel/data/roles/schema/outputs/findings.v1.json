{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "handoff": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "minLength": 1,
              "type": "string"
            },
            "role": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "role",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "closes": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "code": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "evidence": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "evidence_class": {
            "enum": [
              "new_receipt",
              "code_check",
              "cited",
              "opinion"
            ]
          },
          "id": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "location": {
            "additionalProperties": false,
            "properties": {
              "line": {
                "minimum": 1,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "path": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "pointer": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "path",
              "pointer",
              "line"
            ],
            "type": "object"
          },
          "request": {
            "additionalProperties": false,
            "properties": {
              "expected": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "id": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "inputs": {
                "items": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "operation": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "result": {
                "enum": [
                  "pending",
                  "pass",
                  "fail",
                  "unresolved"
                ]
              }
            },
            "required": [
              "id",
              "operation",
              "inputs",
              "expected",
              "result"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "severity": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "statement": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "id",
          "severity",
          "location",
          "code",
          "statement",
          "evidence",
          "closes",
          "evidence_class"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "kind": {
      "const": "findings"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "items",
    "handoff"
  ],
  "type": "object"
}

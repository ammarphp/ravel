{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checklist": {
      "additionalProperties": false,
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "status": {
            "enum": [
              "done",
              "not_applicable",
              "blocked"
            ]
          },
          "unit": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "unit",
          "status",
          "evidence",
          "note"
        ],
        "type": "object"
      },
      "properties": {
        "groups": {
          "items": {
            "additionalProperties": false,
            "allOf": [
              {
                "else": {
                  "properties": {
                    "note": {
                      "minLength": 1,
                      "pattern": "\\S",
                      "type": "string"
                    }
                  }
                },
                "if": {
                  "properties": {
                    "status": {
                      "const": "done"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "evidence": {
                      "minLength": 1,
                      "pattern": "\\S",
                      "type": "string"
                    }
                  }
                }
              }
            ],
            "properties": {
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "indices": {
                "items": {
                  "minimum": 0,
                  "type": "integer"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "done",
                  "not_applicable",
                  "blocked"
                ]
              }
            },
            "required": [
              "indices",
              "status",
              "evidence",
              "note"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "groups"
      ],
      "type": [
        "array",
        "object"
      ]
    },
    "decisions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "cites": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "statement": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "statement",
          "cites"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "escalation": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "type": "array"
          },
          "kind": {
            "enum": [
              "checkin_flag",
              "stop",
              "new_experiment_required",
              "decision_block"
            ]
          },
          "options": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "type": "array"
          },
          "statement": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "statement",
          "evidence"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "handoff": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "minLength": 1,
              "type": "string"
            },
            "role": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "role",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "instruction_ack": {
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "manifest_sha256"
      ],
      "type": "object"
    },
    "kind": {
      "const": "producer-result"
    },
    "knowledge_used": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "literature_used": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "outputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "path",
          "kind"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": 2
    }
  },
  "required": [
    "schema_version",
    "kind",
    "outputs",
    "decisions",
    "knowledge_used",
    "handoff",
    "instruction_ack",
    "checklist",
    "escalation"
  ],
  "type": "object"
}

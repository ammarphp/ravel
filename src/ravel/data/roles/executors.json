  "coordinator": {
    "role": "coordinator",
    "host_may": [
      "plan",
      "route",
      "dispatch",
      "present_checkins",
      "run_smoke_rungs"
    ],
    "host_must_not": "edit anything under stages/ at the full or scan rung"
  },
  "worker_rungs": [
    "full",
    "scan"
  ],
  "budgets": {
    "max_turns": 60,
    "max_wall_seconds": 3600,
    "max_broker_calls": 400,
    "max_cost_usd": null
  },
  "completeness_rule": {
    "implementation_kinds": [
      "science-mode",
      "lifecycle-stage",
      "scoped-adapter"
    ],
    "effects": [
      "executes_native",
      "generates_events",
      "simulates_detector",
      "runs_authored_code"
    ]
  },
  "host_operations": {
    "acquire-published": "Acquires publication metadata and published files without evaluating a scientific model.",
    "literature-query-expansion": "Dispatches the registered expander card for one charged search-hint choice; evaluates no scientific input.",
    "literature-evidence-scoring": "Dispatches the registered scorer card for charged reading-aid scores of served passages; evaluates no scientific input.",
    "literature-discovery-crawl": "Runs bounded charged discovery pages and dispatches the registered selector card; evaluates no scientific input.",
    "fill-template": "Copies accepted result values into declared template bins without rerunning scientific inputs.",
    "grid-recipe": "Writes declared parameter coordinates without evaluating events, predictions or likelihoods.",
    "table-bin-edges": "Reads explicit contiguous intervals from a table without inferring or calculating bin boundaries.",
    "ordinary-study-prepare": "Prepares the declared child work order and scope without evaluating scientific inputs; the coordinator retains its confined preparation receipt."
  }
}

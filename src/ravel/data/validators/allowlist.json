{
  "schema_version": 1,
  "kind": "validator-allowlist",
  "purpose": "Validators a worker may run through the broker as registered_validator actions. broker.register refuses a registered_validator whose id is absent here. Each row names its module and function; roles lists the cards that may run it in addition to the checks named on their own card.",
  "validators": [
    {"id": "check-run", "module": "ravel.workflow.review_projection_checks", "function": "run_check",
     "roles": [], "description": "Dispatcher of the broker action `check run`: runs one row of this allowlist by check_id over workspace files and writes the check result as a pinned output."},
    {"id": "review.normalization_recompute", "module": "ravel.workflow.review_projection_checks", "function": "normalization_recompute",
     "roles": ["normalization-auditor", "re-deriver", "discrepancy-attributor"],
     "description": "Recompute the expected yield sigma x BR x L x K x efficiency from pinned inputs and compare it with the reported yield."},
    {"id": "review.routine_review", "module": "ravel.workflow.review_projection_checks", "function": "routine_review",
     "roles": ["object-selection-mapper", "trap-auditor", "discrepancy-attributor", "plan-critic"],
     "description": "Run the computed items of the routine review checklist over a specification and its encoding."},
    {"id": "review.impossible_spec", "module": "ravel.workflow.review_projection_checks", "function": "impossible_spec",
     "roles": ["plan-critic", "trap-auditor"],
     "description": "Detect an acceptance criterion that contradicts the specification's declared bounds."},
    {"id": "review.lesson_screen", "module": "ravel.workflow.review_projection_checks", "function": "lesson_screen",
     "roles": ["integrity-auditor", "trap-auditor"],
     "description": "Apply the protected-path do-not-learn rule to a proposed lesson."},
    {"id": "review.manuscript_audit", "module": "ravel.workflow.review_projection_checks", "function": "manuscript_audit",
     "roles": ["integrity-auditor"],
     "description": "Compare a manuscript with the stored record: benchmark funnel, held-out exposure, pre-registered metric, selection timing and funnel disclosure."},
    {"id": "review.rubric", "module": "ravel.workflow.review_rubric", "function": "check",
     "roles": ["plan-critic", "physics-critic", "skeptical-verifier", "physics-decider", "integrity-auditor"],
     "description": "Apply a review rubric, with the run's pinned overlay when one is selected, to the review packet an analysis declares."},
    {"id": "review.divergence", "module": "ravel.validation.divergence", "function": "compare",
     "roles": ["physics-decider", "discrepancy-attributor"],
     "description": "Compare two independent implementations of one specification region by region."},
    {"id": "check:validation.input_closure.check", "module": "ravel.validation.input_closure", "function": "check",
     "roles": [], "description": "Input closure of a pinned run (card-named check)."},
    {"id": "check:validation.verify_pack.check_deviations_ledger", "module": "ravel.validation.verify_pack", "function": "check_deviations_ledger",
     "roles": [], "description": "Deviation ledger closure (card-named check)."},
    {"id": "check:validation.certificates.validate_certificate", "module": "ravel.validation.certificates", "function": "validate_certificate",
     "roles": [], "description": "Certificate validation (card-named check)."},
    {"id": "check:physics.normalization_ledger.check", "module": "ravel.physics.normalization_ledger", "function": "check",
     "roles": [], "description": "Normalization ledger recomputation (card-named check)."},
    {"id": "check:validation.validate_cutflow", "module": "ravel.validation.validate_cutflow", "function": null,
     "roles": [], "description": "Tiered cutflow certification (card-named check)."},
    {"id": "check:validation.validate_run_state.check_route", "module": "ravel.validation.validate_run_state", "function": "check_route",
     "roles": [], "description": "Route consistency of a run's detector and statistics modes (card-named check)."},
    {"id": "check:validation.validate_run_state.check_trap_sweep", "module": "ravel.validation.validate_run_state", "function": "check_trap_sweep",
     "roles": [], "description": "Trap-sweep record of a run (card-named check)."},
    {"id": "check:validation.validate_task_contract.validate", "module": "ravel.validation.validate_task_contract", "function": "validate",
     "roles": [], "description": "Task contract validation (card-named check)."},
    {"id": "ravel.validation.calibration_checks", "module": "ravel.validation.calibration_checks", "function": null,
     "roles": [], "description": "Calibration checks named by the detector-calibrator card."}
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Supplied native scan contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "study_id",
    "question",
    "ini",
    "framework",
    "workspace",
    "programmes",
    "runtime",
    "resources",
    "report",
    "continuation",
    "returned"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "operation": {
      "enum": [
        "run",
        "read-returned",
        "continue-native"
      ]
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "$ref": "#/$defs/pin"
    },
    "ini": {
      "$ref": "#/$defs/pin"
    },
    "framework": {
      "$ref": "#/$defs/tree"
    },
    "workspace": {
      "$ref": "#/$defs/tree"
    },
    "programmes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section",
          "inputs",
          "outputs",
          "intermediates",
          "mutable_paths",
          "units",
          "status"
        ],
        "properties": {
          "section": {
            "type": "string",
            "pattern": "^program[1-9][0-9]*$"
          },
          "inputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "intermediates": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mutable_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "units": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtime": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "python",
        "trees",
        "site_roots",
        "versions"
      ],
      "properties": {
        "python": {
          "$ref": "#/$defs/pin"
        },
        "trees": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tree"
          }
        },
        "site_roots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_seconds",
        "max_ram_mib",
        "max_evaluations",
        "max_programme_calls",
        "max_output_bytes",
        "max_output_members",
        "max_copy_bytes"
      ],
      "properties": {
        "max_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_ram_mib": {
          "type": "integer",
          "minimum": 512,
          "maximum": 8192
        },
        "max_evaluations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_programme_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "max_output_members": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_copy_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path",
        "table"
      ],
      "properties": {
        "format": {
          "enum": [
            "json",
            "csv"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "table": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "continuation": {
      "anyOf": [
        {
          "$ref": "#/$defs/pin"
        },
        {
          "type": "null"
        }
      ]
    },
    "returned": {
      "anyOf": [
        {
          "$ref": "#/$defs/pin"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967296
        }
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "manifest"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "$ref": "#/$defs/pin"
        }
      }
    }
  }
}

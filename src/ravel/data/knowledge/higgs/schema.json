{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "synthetic",
    "citations",
    "rows",
    "ratios"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "higgs-reference-tables"
    },
    "synthetic": {
      "type": "boolean"
    },
    "citations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "locator",
          "source_file"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "source_file": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "quantity",
          "process",
          "mass_gev",
          "value",
          "reference_value",
          "unit",
          "uncertainty",
          "citation_key"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "process": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "string",
            "minLength": 1
          },
          "pdf": {
            "type": "string",
            "minLength": 1
          },
          "citation_key": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "enum": [
              "cross_section",
              "branching_ratio"
            ]
          },
          "mass_gev": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "energy_tev": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "reference_value": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "enum": [
              "pb",
              "fb",
              "1"
            ]
          },
          "uncertainty": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minus",
              "plus",
              "definition"
            ],
            "properties": {
              "minus": {
                "type": "number",
                "minimum": 0
              },
              "plus": {
                "type": "number",
                "minimum": 0
              },
              "definition": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "quantity": {
                  "const": "cross_section"
                }
              }
            },
            "then": {
              "required": [
                "energy_tev",
                "order",
                "pdf"
              ],
              "properties": {
                "unit": {
                  "enum": [
                    "pb",
                    "fb"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "value": {
                  "maximum": 1
                },
                "reference_value": {
                  "maximum": 1
                },
                "unit": {
                  "const": "1"
                }
              }
            }
          }
        ]
      }
    },
    "ratios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "numerator",
          "denominator",
          "value",
          "absolute_tolerance",
          "citation_key"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "numerator": {
            "type": "string",
            "minLength": 1
          },
          "denominator": {
            "type": "string",
            "minLength": 1
          },
          "citation_key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "absolute_tolerance": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate literature retrieval v1",
  "$defs": {
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manifest_sha256",
        "policy_view_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_view_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manifest_sha256",
        "policy_view_sha256",
        "token",
        "selector_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_view_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "selector_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_tokens",
        "max_bytes",
        "max_seconds",
        "max_expansions"
      ],
      "properties": {
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 524288
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 524288
        },
        "max_seconds": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 300
        },
        "max_expansions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "version"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "search_args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "top_k",
        "mode",
        "document_scope",
        "filters"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "mode": {
          "enum": [
            "tree",
            "hybrid",
            "flat"
          ]
        },
        "document_scope": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/identity"
          },
          "uniqueItems": true
        },
        "filters": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "get_paper_args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "version",
        "section",
        "page_index",
        "cursor",
        "limit"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "section": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "page_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 99999
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        }
      }
    },
    "list_papers_args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filters",
        "limit",
        "cursor"
      ],
      "properties": {
        "filters": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/cursor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "compare_measurements_args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "groups",
        "top_k_per_group",
        "filters"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "groups": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "top_k_per_group": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "filters": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "request_id",
        "budgets",
        "args"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "operation": {
          "enum": [
            "search",
            "get_paper",
            "list_papers",
            "compare_measurements"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "budgets": {
          "$ref": "#/$defs/budgets"
        },
        "args": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "search"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "#/$defs/search_args"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "get_paper"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "#/$defs/get_paper_args"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "list_papers"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "#/$defs/list_papers_args"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "compare_measurements"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "#/$defs/compare_measurements_args"
              }
            }
          }
        }
      ]
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size",
        "receipt_id"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\x00-\\x1f\\x7f])[^\\\\]+(?<!/)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "receipt_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pin",
        "identifiers",
        "quantities",
        "classes",
        "kind"
      ],
      "properties": {
        "pin": {
          "$ref": "#/$defs/pin"
        },
        "identifiers": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        "quantities": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "classes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "kind": {
          "enum": [
            "source",
            "generated",
            "extracted"
          ]
        }
      }
    },
    "located_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "table-row",
            "table-cell",
            "figure-caption",
            "figure-file",
            "axis-label"
          ]
        },
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "column_span": {
          "type": "integer",
          "minimum": 1
        },
        "header": {
          "type": [
            "string",
            "null"
          ]
        },
        "units": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_path",
        "section_status",
        "page_index",
        "page_number",
        "printed_page_label",
        "line_start",
        "line_end",
        "byte_start",
        "byte_end",
        "space",
        "null_reasons"
      ],
      "properties": {
        "located_unit": {
          "$ref": "#/$defs/located_unit"
        },
        "section_path": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "section_status": {
          "enum": [
            "source",
            "inferred",
            "unavailable"
          ]
        },
        "page_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 99999
            },
            {
              "type": "null"
            }
          ]
        },
        "page_number": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "printed_page_label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            {
              "type": "null"
            }
          ]
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            {
              "type": "null"
            }
          ]
        },
        "byte_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "byte_end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "space": {
          "enum": [
            "original-text",
            "extracted-text",
            "pdf-page-text"
          ]
        },
        "null_reasons": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "enum": [
              "section_path",
              "page_index",
              "page_number",
              "printed_page_label",
              "line_start",
              "line_end"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dense_raw",
        "dense_diffused",
        "bm25",
        "fusion",
        "reranker",
        "rank",
        "graph_paths"
      ],
      "properties": {
        "dense_raw": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1e+100,
              "maximum": 1e+100
            },
            {
              "type": "null"
            }
          ]
        },
        "dense_diffused": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1e+100,
              "maximum": 1e+100
            },
            {
              "type": "null"
            }
          ]
        },
        "bm25": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1e+100,
              "maximum": 1e+100
            },
            {
              "type": "null"
            }
          ]
        },
        "fusion": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1e+100,
              "maximum": 1e+100
            },
            {
              "type": "null"
            }
          ]
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "graph_paths": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        "reranker": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1e+100,
              "maximum": 1e+100
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "literal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "byte_start",
        "byte_end"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "byte_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "byte_end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "conditions"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/literal"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/literal"
            },
            {
              "type": "null"
            }
          ]
        },
        "conditions": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/literal"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "document_id",
        "version",
        "original",
        "extraction",
        "extraction_reason",
        "identifiers",
        "quantities",
        "classes",
        "lineage",
        "acquisition_status",
        "extraction_issues",
        "physics_verified",
        "execution_authorized",
        "unit_id",
        "text",
        "excerpt_sha256",
        "location",
        "scores",
        "group_id",
        "measurement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "original": {
          "$ref": "#/$defs/pin"
        },
        "extraction": {
          "anyOf": [
            {
              "$ref": "#/$defs/produced_pin"
            },
            {
              "type": "null"
            }
          ]
        },
        "extraction_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "identifiers": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        "quantities": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "classes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "lineage": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/descriptor"
          }
        },
        "acquisition_status": {
          "const": "available"
        },
        "extraction_issues": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "physics_verified": {
          "type": "boolean",
          "const": false
        },
        "execution_authorized": {
          "type": "boolean",
          "const": false
        },
        "unit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 524288
        },
        "excerpt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "scores": {
          "$ref": "#/$defs/scores"
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "measurement": {
          "anyOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "document_id",
        "version",
        "original",
        "extraction",
        "extraction_reason",
        "identifiers",
        "quantities",
        "classes",
        "lineage",
        "acquisition_status",
        "extraction_issues",
        "physics_verified",
        "execution_authorized",
        "title",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "original": {
          "anyOf": [
            {
              "$ref": "#/$defs/pin"
            },
            {
              "type": "null"
            }
          ]
        },
        "extraction": {
          "anyOf": [
            {
              "$ref": "#/$defs/produced_pin"
            },
            {
              "type": "null"
            }
          ]
        },
        "extraction_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "identifiers": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },

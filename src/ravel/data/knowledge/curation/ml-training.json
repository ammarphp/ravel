        "a",
        "b"
       ],
       "id_column": "event_id",
       "label": "y",
       "manifest_sha256": "805878b3ea776cb611a4e0cde32192555f9ae5f5f6ea6427ca1af19d1bbb8a52",
       "pins": [
        {
         "path": "data/train.npz",
         "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        {
         "path": "data/val.npz",
         "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

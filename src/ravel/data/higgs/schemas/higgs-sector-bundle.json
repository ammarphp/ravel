{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ravel:higgs-sector-bundle:1",
  "title": "Declared Higgs-sector bundle",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "higgs-sector-bundle"
    },
    "input_kind": {
      "enum": [
        "effective-couplings",
        "slha",
        "direct-rates"
      ]
    },
    "neutral_scalars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "mass_gev": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "width_gev": {
            "type": "number",
            "minimum": 0
          },
          "couplings": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "branching_ratios": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "rates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "collider": {
                  "type": "string",
                  "minLength": 1
                },
                "production": {
                  "type": "string",
                  "minLength": 1
                },
                "decay": {
                  "type": "string",
                  "minLength": 1
                },
                "sigma_br_pb": {
                  "type": "number",
                  "minimum": 0
                },
                "production_pb": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "collider",
                "production",
                "decay",
                "sigma_br_pb"
              ],
              "additionalProperties": false
            }
          },
          "cp": {
            "enum": [
              "even",
              "odd",
              "mixed"
            ]
          }
        },
        "required": [
          "id",
          "mass_gev",
          "width_gev",
          "couplings",
          "branching_ratios",
          "rates",
          "cp"
        ],
        "additionalProperties": false
      }
    },
    "charged_scalars": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "mass_gev": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "width_gev": {
            "type": "number",
            "minimum": 0
          },
          "couplings": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "branching_ratios": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "rates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "collider": {
                  "type": "string",
                  "minLength": 1
                },
                "production": {
                  "type": "string",
                  "minLength": 1
                },
                "decay": {
                  "type": "string",
                  "minLength": 1
                },
                "sigma_br_pb": {
                  "type": "number",
                  "minimum": 0
                },
                "production_pb": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "collider",
                "production",
                "decay",
                "sigma_br_pb"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "mass_gev",
          "width_gev",
          "couplings",
          "branching_ratios",
          "rates"
        ],
        "additionalProperties": false
      }
    },
    "datasets": {
      "type": "object",
      "properties": {
        "hbdataset": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "path",
            "commit",
            "files"
          ],
          "additionalProperties": false
        },
        "hsdataset": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "path",
            "commit",
            "files"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "hbdataset",
        "hsdataset"
      ],
      "additionalProperties": false
    },
    "mass_assignment": {
      "type": "object",
      "properties": {
        "window_gev": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "particle_ids": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "choice": {
                "enum": [
                  "native"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "particle_ids",
              "choice",
              "basis"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "window_gev",
        "basis",
        "choices"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "coupling_normalization": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "slha_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "native_coupling_defaults": {
          "type": "object",
          "properties": {
            "parameters": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "parameters",
            "basis"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "source",
        "coupling_normalization"
      ],
      "additionalProperties": false
    },
    "sm_reference": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "degrees_of_freedom": {
      "type": "object",
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1
        },
        "statistic": {
          "const": "chi2_total"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "statistic",
        "basis"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "input_kind",
    "neutral_scalars",
    "charged_scalars",
    "datasets",
    "mass_assignment",
    "provenance"
  ],
  "additionalProperties": false
}

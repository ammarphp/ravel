                "polynomial": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "terms": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "coefficient": {
                            "type": "number"
                          },

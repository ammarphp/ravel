                          "powers"
                        ]
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "terms"
                  ]
                }
              },
              "required": [
                "mode",
                "polynomial"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "const": "effective"
                },
                "parameter": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "mode",
                "parameter"
              ]
            }
          ]
        },
        "gamma": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "const": "resolved"
                },
                "polynomial": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "terms": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "coefficient": {
                            "type": "number"
                          },
                          "powers": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "minProperties": 0,
                            "propertyNames": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "required": [
                          "coefficient",
                          "powers"
                        ]
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "terms"
                  ]
                }
              },
              "required": [
                "mode",
                "polynomial"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "const": "effective"
                },
                "parameter": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "mode",
                "parameter"
              ]
            }
          ]
        },
        "Zgamma": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "const": "resolved"
                },
                "polynomial": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "terms": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "coefficient": {
                            "type": "number"
                          },
                          "powers": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "minProperties": 0,
                            "propertyNames": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "required": [
                          "coefficient",
                          "powers"
                        ]
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "terms"
                  ]
                }
              },
              "required": [
                "mode",
                "polynomial"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "const": "effective"
                },
                "parameter": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "mode",
                "parameter"
              ]
            }
          ]
        }
      },
      "required": []
    },
    "bsm_parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "combined": {
          "type": "string",
          "minLength": 1
        },
        "invisible": {
          "type": "string",
          "minLength": 1
        },
        "undetected": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": []
    },
    "vector_parameters": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "vector_upper_bound": {
      "const": 1.0,
      "description": "Limits the magnitude of every declared vector parameter to one."
    },
    "width_constraint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sigma": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "value",
        "sigma"
      ]
    },
    "heft_dictionary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kappa_V": {
          "type": "string",
          "minLength": 1
        },
        "kappa_F": {
          "type": "string",
          "minLength": 1
        },
        "c_gg": {
          "type": "string",
          "minLength": 1
        },
        "c_gammagamma": {
          "type": "string",
          "minLength": 1
        },
        "kappa_2V": {
          "type": "string",
          "minLength": 1
        },
        "c_2": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kappa_V",
        "kappa_F",
        "c_gg",
        "c_gammagamma",
        "kappa_2V",
        "c_2"
      ]
    },
    "heft_normalization": {
      "type": "string",
      "minLength": 1
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                },
                "minProperties": 0,
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 1
              },
              "uncertainty": {
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minItems": 1
              }
            },
            "required": [
              "parameters",
              "values",
              "uncertainty"
            ]
          },
          "minItems": 1
        },
        "tolerance_sigma": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "points",
        "tolerance_sigma"
      ]
    },
    "source_pins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "source",
          "sha256"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "framework",
    "mass_gev",
    "convention",
    "parameters",
    "production",
    "decays",
    "branching_fractions",
    "rates"
  ],
  "description": "Supplied dimensionless production and partial-width modifiers; complete SM decay fractions; total width scaled by 1/(1-BR_BSM). Each loop declares resolved polynomial or effective squared modifier. HEFT contact normalization is supplied. Closure values use rate order and declared rate units."
}

      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      }
    },
    "rates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "production": {
            "type": "string",
            "minLength": 1
          },
          "decay": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "enum": [
              "1",
              "pb",
              "fb",
              "ab"

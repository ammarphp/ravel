      "const": 1
    },
    "kind": {
      "const": "higgs-parameterization-bundle"
    },
    "framework": {
      "enum": [
        "kappa",
        "heft-lo"
      ]
    },
    "mass_gev": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "convention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": "string",
          "minLength": 1
        },
        "pdf": {
          "type": "string",
          "minLength": 1
        },
        "branching_program": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "order",
        "pdf",
        "branching_program"
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "initial": {
            "type": "number"
          },
          "sm": {
            "type": "number"
          },
          "fixed": {
            "type": "boolean"
          },
          "bounds": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "initial",
          "sm",
          "fixed",
          "bounds"
        ]
      },
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "parameter": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "parameter"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "loop": {
                "enum": [
                  "g",
                  "gamma",
                  "Zgamma"
                ]
              }
            },
            "required": [
              "loop"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "constant": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "constant"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "polynomial": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "terms": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "coefficient": {
                          "type": "number"
                        },
                        "powers": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "minProperties": 0,
                          "propertyNames": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "coefficient",
                        "powers"
                      ]
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "terms"
                ]
              }
            },
            "required": [
              "polynomial"
            ]
          }
        ]
      },
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      }
    },
    "decays": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "parameter": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "parameter"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "loop": {
                "enum": [
                  "g",
                  "gamma",
                  "Zgamma"
                ]
              }
            },
            "required": [
              "loop"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "constant": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "constant"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "polynomial": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "terms": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "coefficient": {
                          "type": "number"
                        },
                        "powers": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "minProperties": 0,
                          "propertyNames": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "coefficient",
                        "powers"
                      ]
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "terms"
                ]
              }
            },
            "required": [
              "polynomial"
            ]
          }
        ]
      },
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      }
    },
    "branching_fractions": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1

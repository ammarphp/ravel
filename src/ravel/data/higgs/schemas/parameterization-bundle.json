        "required": [
          "id",
          "production",
          "decay",
          "unit",
          "sm_value"
        ]
      },
      "minItems": 1
    },
    "loops": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "g": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "const": "resolved"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "param_template",
    "run_template",
    "process_card",
    "parameters",
    "bindings",
    "run_controls",
    "launch_template"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "param_template": {
      "type": "string",
      "minLength": 1
    },
    "run_template": {
      "type": "string",
      "minLength": 1
    },
    "process_card": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number"
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "parameter",
              "placeholder"
            ],
            "properties": {
              "parameter": {
                "type": "string"
              },
              "placeholder": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "parameter",
              "block",
              "indices"
            ],
            "properties": {
              "parameter": {
                "type": "string"
              },
              "block": {
                "type": "string"
              },
              "indices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer"
                }
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "run_controls": {
      "type": "object",
      "required": [
        "nevents",
        "iseed",
        "ebeam1",
        "ebeam2",
        "pdlabel",
        "ickkw",
        "use_syst"
      ],
      "additionalProperties": {
        "type": [
          "number",
          "boolean",
          "string"
        ]
      }
    },
    "expected_masses": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number"
      }
    },
    "launch_template": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}

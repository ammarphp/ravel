{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "axes",
    "max_points",
    "quantities",
    "datasets",
    "output",
    "template_toml",
    "subst",
    "run_root",
    "run_prefix"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "axes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "name",
          "values"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,80}$"
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "max_points": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": {
          "type": "number"
        }
      }
    },
    "quantities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "source",
          "field"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "format",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "json",
            "csv"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "template_toml": {
      "type": "string",
      "minLength": 1
    },
    "subst": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "run_root": {
      "type": "string",
      "minLength": 1
    },
    "run_prefix": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,100}$"
    },
    "model": {
      "type": "string"
    },
    "analysis_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

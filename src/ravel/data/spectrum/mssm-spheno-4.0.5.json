  "scope": "Released real R-parity-conserving weak-scale MSSM, explicit diagonal soft inputs, source CKM and loop conventions; consistent new spectrum and decay origin only.",
  "conventions": {
    "external_scale": "EXTPAR0 is Q in GeV; SetRGEScale stores Q squared internally",
    "soft_inputs": "EXTPAR31..49 are masses GeV, squared by the reader",
    "higgs_branch": "EXTPAR23 is signed mu GeV, EXTPAR24 is running m_A squared GeV^2; EXTPAR21/22/26 excluded to avoid ignored/replaced inputs",
    "tanbeta": "MINPAR3 at mZ; EXTPAR25 excluded in this first explicit branch",
    "CP": "MODSEL5=0 real MSSM; VCKMIN4=0; no CP phases inferred",
    "flavour": "MODSEL6=0; all15 diagonal soft masses supplied, first/second generation trilinears follow the released source zero initialization",
    "pion_constants": "m_pi0=.135 GeV, m_pip=.140 GeV, f_pi=.092 GeV from released StandardModel source unless a separately supported native setting is added",
    "missing_width": "unknown, never zero/stable from absence",
    "total_width": "native complete emitted DECAY width, not a manually assembled branching sum"
  },
  "limitations": [
    "Native spectrum and partial/total widths require independent actual validation.",
    "Source quark three-body gate uses delta_m>0.3 GeV; single-pion replacement is conditional on width exceeding the first nine quark three-body widths.",

{
  "schema_version": 1,
  "kind": "transport",
  "id": "http-azure-chat",
  "transport_kind": "http-model",
  "launcher": null,
  "argv_template": [],
  "models": [
    {
      "id": "{configured}",
      "family": "openai",
      "tiers": [
        "judgment",
        "agent",
        "cheap"
      ]
    }
  ],
  "auth": {
    "kind": "env",
    "env_names": [
      "AZURE_OPENAI_API_KEY"
    ],
    "command": null,
    "header_style": "api-key"
  },
  "pass_env": [],
  "billing": "api",
  "capabilities": {
    "tools": "none",
    "isolation": "ravel-sandbox",
    "attestation": "transport",
    "structured_output": true,
    "blind_capable": true,
    "effort_control": false,
    "session_id": false,
    "usage_report": true
  },
  "max_concurrent": 2,
  "qualification": {
    "status": "declared",
    "record": null
  },
  "notes": "Stateless request: the prepared packet is the only input the model sees, and no tools are offered. The host config names the deployment endpoint; Entra ID uses a token command with a bearer header instead."
}

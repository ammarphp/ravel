{
  "schema_version": 1,
  "kind": "transport",
  "id": "claude-cli-worker-bedrock",
  "transport_kind": "cli-worker",
  "launcher": "claude",
  "argv_template": [
    "claude",
    "-p",
    "--output-format",
    "json",
    "--model",
    "{model}",
    "--effort",
    "{effort}",
    "--json-schema",
    "{schema}",
    "--setting-sources",
    "project",
    "--restricted",
    "--strict-mcp-config",
    "--no-session-persistence",
    "--tools",
    "{tools}",
    "--allowedTools",
    "{tools}",
    "--max-budget-usd",
    "{usd}"
  ],
  "models": [
    {
      "id": "{configured}",
      "family": "anthropic",
      "tiers": [
        "judgment",
        "agent",
        "cheap"
      ]
    }
  ],
  "auth": {
    "kind": "env",
    "env_names": [
      "AWS_PROFILE"
    ],
    "command": null,
    "header_style": null
  },
  "pass_env": [
    "CLAUDE_CODE_USE_BEDROCK",
    "AWS_REGION",
    "AWS_CONFIG_FILE",
    "AWS_SHARED_CREDENTIALS_FILE"
  ],
  "billing": "api",
  "capabilities": {
    "tools": "broker-full",
    "isolation": "ravel-sandbox",
    "attestation": "transport",
    "structured_output": true,
    "blind_capable": true,
    "effort_control": true,
    "session_id": true,
    "usage_report": true
  },
  "max_concurrent": 2,
  "qualification": {
    "status": "declared",
    "record": null
  },
  "notes": "Claude Code routed to Amazon Bedrock by declared environment names (CLAUDE_CODE_USE_BEDROCK=1, AWS_PROFILE, AWS_REGION).",
  "worker_surface": {
    "mcp": {
      "config": "mcp_config_flag",
      "argv": [
        "--mcp-config",
        "{mcp_config}"
      ]
    },
    "structured_output": "enforced"
  }
}

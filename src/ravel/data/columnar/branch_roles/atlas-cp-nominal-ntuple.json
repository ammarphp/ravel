{
 "schema_version": 1,
 "kind": "columnar-branch-roles",
 "name": "atlas-cp-nominal-ntuple",
 "source": "Naming convention of ATLAS CP-algorithms flat ntuples written by TopCPToolkit-style analysis configs: <container>_<decoration>[_<systematic>] with the nominal systematic written NOSYS, selection flags written <container>_select_<name>, particle-level containers prefixed PL_, kinematics in MeV. Public documentation: https://topcptoolkit.docs.cern.ch/latest/settings/ntupling/ (container prefix, selection-flag prefix and systematics-suffix options). Structural roles only: whether a branch exists in a given production is a fact of the supplied branch schema. Container rows: lepton, photon and tau containers store baseline and signal flags, jets and large-R jets only the stored selection, large-R jets admit only the large-R overlap-removal flag.",
 "branches": [
  {
   "name": "runNumber",
   "role": "event_identifier",
   "shape": "scalar",
   "unit": "1"
  },
  {
   "name": "eventNumber",
   "role": "event_identifier",
   "shape": "scalar",
   "unit": "1"
  },
  {

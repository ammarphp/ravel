{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ravel:measurement_bundle.v1",
  "title": "measurement_bundle.v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "measurement-bundle"
    },
    "source": {
      "type": "object",
      "properties": {
        "hepdata": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "tables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "doi": {
          "type": "string"
        },
        "sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "required": [
        "hepdata",
        "version",
        "tables",
        "doi",
        "sha256"
      ],
      "additionalProperties": false
    },
    "routine": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "type": "object"
            },
            "record_version": {
              "type": "integer",
              "minimum": 1
            },
            "ref_yoda_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "table_map_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "version",
            "options",
            "record_version",
            "ref_yoda_sha256",
            "source_sha256",
            "table_map_sha256"
          ],
          "additionalProperties": false
        }
      ]
    },
    "observable": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string"
        },
        "level": {
          "enum": [
            "born",
            "dressed",
            "bare",
            "parton",
            "detector"
          ]
        }
      },
      "required": [
        "name",
        "unit",
        "level"
      ],
      "additionalProperties": false
    },
    "normalization": {
      "enum": [
        "absolute",
        "normalized",
        "ratio"
      ]
    },
    "normalization_weights": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "number"
          }
        }
      ]
    },
    "bin_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "lo": {
            "type": "number"
          },
          "hi": {
            "type": "number"
          }
        },
        "required": [
          "lo",
          "hi"
        ],
        "additionalProperties": false
      }
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "number"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "stat",
              "syst",
              "lumi",
              "mcstat",
              "model"
            ]
          },
          "symmetrized": {
            "enum": [
              "none",
              "average",
              "max"
            ]
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "correlation": {
            "type": "string",
            "pattern": "^(diagonal|full|matrix:.+|declared:.+)$"
          },
          "declaration": {
            "type": "object"
          }
        },
        "required": [
          "name",
          "kind",
          "symmetrized",
          "values",
          "correlation",
          "declaration"
        ],
        "additionalProperties": false
      }
    },
    "covariance": {
      "type": "object",
      "properties": {
        "total": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "number"
            }
          }
        },
        "by_component": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "number"
              }
            }
          }
        },
        "rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "psd": {
          "const": true
        },
        "law": {
          "enum": [
            "absolute-covariance",
            "ratio-covariance",
            "normalized-rank-n-minus-one"
          ]
        }
      },
      "required": [
        "total",
        "by_component",
        "rank",
        "psd",
        "law"
      ],
      "additionalProperties": false
    },
    "fiducial": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "routine_bookings": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "text",
        "routine_bookings"
      ],
      "additionalProperties": false
    },
    "assembly_checks": {
      "type": "object",
      "properties": {
        "total_reproduced_max_rel_dev": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.001
        },
        "rule_for_asymmetric": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "none",
              "average",
              "max"
            ]
          }
        },
        "stated_total": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "excluded_errors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "total_symmetrization": {
          "enum": [
            "none",
            "average",
            "max"
          ]
        }
      },
      "required": [
        "total_reproduced_max_rel_dev",
        "rule_for_asymmetric",
        "stated_total",
        "excluded_errors",
        "total_symmetrization"
      ],
      "additionalProperties": false
    },
    "physics_validated": {
      "const": false
    },
    "status": {
      "const": "passed"
    },
    "status_scope": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "source",
    "routine",
    "observable",
    "normalization",
    "normalization_weights",
    "bin_ids",
    "bins",
    "values",
    "components",
    "covariance",
    "fiducial",
    "assembly_checks",
    "physics_validated"
  ],
  "additionalProperties": false
}

{
  "title": "route-spec.v1: a route as data, compiled into a plan (CONTROLLER-SPEC 5.2)",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "match",
    "steps",
    "deliverables"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "route-spec"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "match": {
      "type": "object",
      "required": [
        "row",
        "when"
      ],
      "additionalProperties": false,
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "when": {
          "type": "object"
        }
      }
    },
    "admits_scientific_deliverables": {
      "type": "boolean"
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "from"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "from": {
            "type": "string",
            "pattern": "^(fact|constraint|contract|reading|deliverables|supplied)(:[A-Za-z0-9_.-]+)?$"
          },
          "required": {
            "type": "boolean"
          },
          "default": {},
          "description": {
            "type": "string"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "checkin": {
            "type": "string",
            "enum": [
              "checkin1",
              "checkin2",
              "checkin3",
              "deviation"
            ]
          },
          "seats": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "role"
              ],
              "properties": {
                "seat": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$"
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "template_id": {
            "type": "string",
            "minLength": 1
          },
          "engagement": {
            "type": "object"
          },
          "engagement_folded_into": {
            "type": "string",
            "minLength": 1
          },
          "correction_rounds": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "checkins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "checkin1",
              "checkin2",
              "checkin3"
            ]
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "seats": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "match",
          "step",
          "output"
        ],
        "additionalProperties": false,
        "properties": {
          "match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "artifact": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "claim": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "any": {
                "type": "boolean"
              }
            }
          },
          "step": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "instruction_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "description": {
      "type": "string"
    },
    "adapter": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ledger-entry.v1",
  "title": "ledger-entry.v1: one append-only event of a controller run's obligation ledger",
  "description": "CONTROLLER-SPEC 7.3. sha256 is the digest of the canonical JSON (sorted keys, no spaces, UTF-8) of schema, seq, prev and body; prev is the previous event's sha256, 64 zeros for the first. A store may wrap the event or add its own fields; the chain covers only these five. Definitions are inlined so the repository's schema subset validates it.",
  "type": "object",
  "required": [
    "schema",
    "seq",
    "prev",
    "body",
    "sha256"
  ],
  "properties": {
    "schema": {
      "const": "ledger-entry.v1"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "prev": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "body": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event",
            "stage",
            "run_id",
            "time_ns",
            "catalogue_sha256",
            "context",
            "context_sha256",
            "instances"
          ],
          "properties": {
            "event": {
              "const": "materialise"
            },
            "stage": {
              "enum": [
                "intake",
                "plan",
                "dispatch",
                "review",
                "deliver",
                "event"
              ]
            },
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "time_ns": {
              "type": "integer",
              "minimum": 0
            },
            "catalogue_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "context": {
              "type": "object"
            },
            "context_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "pins": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "catalogue_sha256",
                "gate_registry_sha256"
              ],
              "properties": {
                "catalogue_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "gate_registry_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "instances": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "id",
                  "scope"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "step": {
                        "type": "string"
                      },
                      "point": {
                        "type": "string"
                      },
                      "seat": {
                        "type": "string"
                      },
                      "attempt": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "deliverable": {
                        "type": "string"
                      },
                      "artifact": {
                        "type": "string"
                      },
                      "claim": {
                        "type": "string"
                      },
                      "event": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event",
            "run_id",
            "time_ns",
            "changes"
          ],
          "properties": {
            "event": {
              "const": "status"
            },
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "time_ns": {
              "type": "integer",
              "minimum": 0
            },
            "changes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "from",
                  "to",
                  "evidence"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "from": {
                    "enum": [
                      "pending",
                      "satisfied",
                      "violated",
                      "waived",
                      "not_applicable"
                    ]
                  },
                  "to": {
                    "enum": [
                      "satisfied",
                      "violated",
                      "waived",
                      "not_applicable"
                    ]
                  },
                  "evidence": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}

{
  "title": "plan.v1: a compiled controller plan (route spec or judgment plan)",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "route",
    "steps",
    "deliverables",
    "waypoints",
    "sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "controller-plan"
    },
    "run_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "route": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "spec_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "step.v1"
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "mapped",
              "open"
            ]
          },
          "step": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "output": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![/~])(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9_.@+=/:-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "claim_kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "artifact_kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "waypoints": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      }
    },
    "checkins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "checkin1",
              "checkin2",
              "checkin3"
            ]
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "seats": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "engagement_seats": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "role"
              ],
              "properties": {
                "seat": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$"
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "seat_counts": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            }
          },
          "review_points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "row",
                "roles",
                "mode",
                "gate",
                "blocking"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "row": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "mode": {
                  "enum": [
                    "specialist",
                    "voting",
                    "advisory"
                  ]
                },
                "gate": {
                  "enum": [
                    "approve_plan",
                    "checkin2_accept",
                    "delivery",
                    "final_task"
                  ]
                },
                "blocking": {
                  "const": true
                },
                "roles": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "role",
                      "count"
                    ],
                    "properties": {
                      "role": {
                        "type": "string",
                        "minLength": 1
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_obligations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "instruction_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reading_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "contract_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "engagement": {
      "type": "object"
    },
    "request_pins": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          },
          {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        ]
      }
    }
  }
}

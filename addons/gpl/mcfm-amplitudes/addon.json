{
  "schema_version": 1,
  "name": "mcfm-amplitudes",
  "license": "GPL-3.0-or-later",
  "summary": "Per-point helicity amplitudes for interfering resonances",
  "upstream": {
    "name": "MCFM",
    "version": "10.2.1",
    "commit": "0adaa4ed4079de1b17c84417a0a428a468f57e69",
    "repository": "https://gitlab.com/mcfm-team/releases"
  },
  "program": "ravel_mcfm_amplitudes",
  "overlay": [
    "ravel_bridge.f90",
    "ravel_driver.f90",
    "lowint-capture.patch",
    "CMakeLists-ravel.cmake"
  ],
  "files": {
    "ravel_bridge.f90": "612bba3cb31022158ee8173dbc7310a3b9e6cee3b3b0cec50f6e578c69a4cc3f",
    "ravel_driver.f90": "670e6a9be983c0f8d36f9955113e3290628c97aac321f7a00b8ace534d1c6e3d",
    "lowint-capture.patch": "414a870631fc6df128c54844a913105315d4bd2050409c33113f62ee98a556bd",
    "CMakeLists-ravel.cmake": "3d2dcfb7a1c97c9324177ab2b0683670d5c9fcee5329e0f2d78ca5e184fea9b9",
    "upstream-api.json": "0f11a9064e50b4a6cc7e4304501f839a59a593dd9c5d5f2e07c00d3da6543355",
    "COPYING.GPL-3.txt": "8ceb4b9ee5adedde47b31e975c1d90c73ad27b6b165a1dcd80c7c545eb65b903"
  },
  "protocol": {
    "format": "RAVEL_MCFM_2",
    "operations": {
      "points": 0,
      "warmup": 1,
      "block": 2
    },
    "control_file": "ravel-control.dat",
    "card_file": "input.ini",
    "points_file": "ravel-points.dat",
    "grid_file": "proposal-grid.bin",
    "output_file": "amplitudes.dat",
    "channels": {
      "1": {
        "label": "different-flavour lepton pairs",
        "pdg": [
          21,
          21,
          11,
          -11,
          13,
          -13
        ]
      },
      "2": {
        "label": "identical electrons",
        "pdg": [
          21,
          21,
          11,
          -11,
          11,
          -11
        ]
      },
      "3": {
        "label": "identical muons",
        "pdg": [
          21,
          21,
          13,
          -13,
          13,
          -13
        ]
      }
    },
    "amplitude_channels": [
      "up",
      "down",
      "bottom",
      "top",
      "hbottom",
      "htop"
    ],
    "members": {
      "continuum": {
        "sum": {
          "up": 2,
          "down": 2,
          "bottom": 1,
          "top": 1
        }
      },
      "scalar_bottom": {
        "sum": {
          "hbottom": 1
        },
        "per_reference_propagator": true
      },
      "scalar_top": {
        "sum": {
          "htop": 1
        },
        "per_reference_propagator": true
      }
    },
    "oracle_continuum_member": "continuum",
    "factor": [
      "grid_weight_over_n",
      "phase_space",
      "flux",
      "pdf_product"
    ],
    "factor_divisor": "branching_ratio",
    "factor_unit": "fb"
  }
}
